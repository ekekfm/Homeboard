rules_version = '2';
// 업무 보드 보안 규칙
// - 로그인한 본인만 users/{본인 uid} 아래를 읽고 쓸 수 있다.
// - 정해진 컬렉션에만, 정해진 칸만 저장할 수 있다.
// - 새 기록은 v = 1, 고칠 때는 직전 v + 1 이어야 한다(동시 수정·중복 입력 방지).
// - 문서를 완전히 지우는 요청은 막는다(지우기는 deletedAt 표시로만).
// - 가계부 금액은 1원 이상의 정수여야 한다. 이체(tr)는 받는 계좌가 있어야 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function knownCol(col) {
      return col in ['tasks', 'events', 'biz', 'leads', 'logs', 'notes', 'links',
                     'work', 'timelog', 'ideas', 'notebooks', 'settings', 'allocs', 'ledger',
                     'accounts', 'recurring', 'budgets', 'probe'];
    }
    function okShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'v', 'wid', 'dev', 'at', 'deletedAt'])
        && d.keys().hasAll(['data', 'v', 'wid', 'dev', 'at'])
        && d.data is map
        && d.v is int
        && d.wid is string && d.wid.size() <= 40
        && d.dev is string && d.dev.size() <= 40
        && d.at == request.time
        && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt == request.time
            || (resource != null && d.deletedAt == resource.data.get('deletedAt', null)));
    }
    function okLedger(col) {
      let x = request.resource.data.data;
      return col != 'ledger' || (
        x.amt is int && x.amt > 0 && x.amt <= 100000000000
        && x.type in ['in', 'out', 'tr']
        && (x.type != 'tr' || (x.to is string && x.to.size() > 0))
        && x.date is string && x.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function okAmount(col) {
      let x = request.resource.data.data;
      return col != 'allocs' || (x.amt is number && x.amt >= 0);
    }

    match /users/{uid}/{col}/{id} {
      allow read: if isOwner(uid) && knownCol(col);
      allow create: if isOwner(uid) && knownCol(col) && okShape()
        && request.resource.data.v == 1 && okLedger(col) && okAmount(col);
      allow update: if isOwner(uid) && knownCol(col) && okShape()
        && request.resource.data.v == resource.data.v + 1 && okLedger(col) && okAmount(col);
      allow delete: if false;
    }
  }
}
